{
  "$defs": {
    "AxeViolation": {
      "additionalProperties": false,
      "description": "One axe-core violation.",
      "properties": {
        "id": {
          "description": "The rule ID.",
          "type": "string"
        },
        "impact": {
          "description": "The impact axe reported.",
          "type": [
            "string",
            "null"
          ]
        },
        "nodes": {
          "description": "How many nodes matched.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "nodes"
      ],
      "type": "object"
    },
    "BlobRef": {
      "description": "A content-addressed blob reference, written as `sha256:<hex>`.",
      "type": "string"
    },
    "Control": {
      "additionalProperties": false,
      "description": "One interactive control, with its selector candidates in preference order.",
      "properties": {
        "form": {
          "anyOf": [
            {
              "$ref": "#/$defs/Form"
            },
            {
              "type": "null"
            }
          ],
          "description": "The form the control belongs to, when it is in one."
        },
        "name": {
          "description": "The accessible name.",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/ControlPurpose",
          "description": "`login`, `logout`, `submit` or `action`."
        },
        "role": {
          "description": "The ARIA role.",
          "type": "string"
        },
        "screen": {
          "description": "The route the control is on.",
          "type": "string"
        },
        "selectors": {
          "description": "Selector candidates: role plus name first, then test ID, then CSS.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "screen",
        "role",
        "name",
        "selectors",
        "purpose"
      ],
      "type": "object"
    },
    "ControlPurpose": {
      "description": "What a control is for.",
      "oneOf": [
        {
          "const": "login",
          "description": "The login control.",
          "type": "string"
        },
        {
          "const": "logout",
          "description": "The logout control.",
          "type": "string"
        },
        {
          "const": "submit",
          "description": "A form submit control.",
          "type": "string"
        },
        {
          "const": "action",
          "description": "Anything else.",
          "type": "string"
        }
      ]
    },
    "DbDelta": {
      "additionalProperties": false,
      "description": "What the DB channel saw.",
      "properties": {
        "delete": {
          "$ref": "#/$defs/RowCounts",
          "description": "Rows deleted."
        },
        "insert": {
          "$ref": "#/$defs/RowCounts",
          "description": "Rows inserted."
        },
        "update": {
          "$ref": "#/$defs/RowCounts",
          "description": "Rows updated."
        }
      },
      "required": [
        "insert",
        "update",
        "delete"
      ],
      "type": "object"
    },
    "EgressEntry": {
      "additionalProperties": false,
      "description": "One third-party request the egress proxy saw.\n\nThe path and the status are here as well as the host because the checks need them: a canary\nsmuggled in a query string is only visible in the path (B13), and a request that reached a paid\nprovider and got a 401 is a different finding from one that never left (B26).",
      "properties": {
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The request body, as a blob."
        },
        "bytes": {
          "description": "The request size in bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "denied": {
          "description": "Whether the run's allow list refused it.",
          "type": "boolean"
        },
        "host": {
          "description": "The host contacted.",
          "type": "string"
        },
        "method": {
          "description": "The method.",
          "type": "string"
        },
        "path": {
          "description": "The path and query, as the proxy saw them.",
          "type": "string"
        },
        "status": {
          "description": "The status the client received, or 0 when there was no response at all.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "host",
        "method",
        "path",
        "status",
        "denied",
        "bytes"
      ],
      "type": "object"
    },
    "EmailEntry": {
      "additionalProperties": false,
      "description": "One email the app sent.",
      "properties": {
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The body, as a blob."
        },
        "subject": {
          "description": "The subject.",
          "type": "string"
        },
        "to": {
          "description": "The recipient.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "to",
        "subject"
      ],
      "type": "object"
    },
    "Field": {
      "additionalProperties": false,
      "description": "One form field.",
      "properties": {
        "kind": {
          "description": "`text`, `email`, `password`, `number`, `date`, `checkbox` or `select`.",
          "type": "string"
        },
        "max": {
          "description": "Maximum length or value, when present.",
          "type": [
            "string",
            "null"
          ]
        },
        "min": {
          "description": "Minimum length or value, when present.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The field name.",
          "type": "string"
        },
        "pattern": {
          "description": "The HTML `pattern`, when present.",
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "description": "Whether the field is required.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind",
        "required"
      ],
      "type": "object"
    },
    "Form": {
      "additionalProperties": false,
      "description": "A form and its fields.",
      "properties": {
        "fields": {
          "description": "Fields in document order.",
          "items": {
            "$ref": "#/$defs/Field"
          },
          "type": "array"
        },
        "selector": {
          "description": "The form's selector.",
          "type": "string"
        }
      },
      "required": [
        "selector",
        "fields"
      ],
      "type": "object"
    },
    "LayoutBox": {
      "additionalProperties": false,
      "description": "One element box, for layout checks.",
      "properties": {
        "clickable": {
          "description": "Whether the element is clickable.",
          "type": "boolean"
        },
        "height": {
          "description": "Height in CSS pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "selector": {
          "description": "The selector that found the element.",
          "type": "string"
        },
        "width": {
          "description": "Width in CSS pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "description": "Left edge in CSS pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "description": "Top edge in CSS pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "selector",
        "x",
        "y",
        "width",
        "height",
        "clickable"
      ],
      "type": "object"
    },
    "Logs": {
      "additionalProperties": false,
      "description": "Counts the driver and the recorder collect from the browser and the server.",
      "properties": {
        "console_errors": {
          "description": "Uncaught console errors.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "page_errors": {
          "description": "Uncaught page errors.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "server_errors": {
          "$ref": "#/$defs/Measured2",
          "description": "Server error lines between action start and settle."
        },
        "server_lines": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The matching server lines, as a blob."
        }
      },
      "required": [
        "console_errors",
        "page_errors",
        "server_errors"
      ],
      "type": "object"
    },
    "Measured": {
      "description": "The value a channel produced, or why it produced none.\n\nEvery channel of an [`crate::model::EffectRecord`] is wrapped in this, so\n\"nothing happened\" stays distinguishable from \"nothing was watched\".",
      "oneOf": [
        {
          "description": "The channel was observed and holds `value`.",
          "properties": {
            "status": {
              "const": "measured",
              "type": "string"
            },
            "value": {
              "description": "What the channel observed.",
              "items": {
                "$ref": "#/$defs/WsFrame"
              },
              "type": "array"
            }
          },
          "required": [
            "status",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "The channel could not be observed; `reason` says why.",
          "properties": {
            "reason": {
              "description": "Why the channel is missing, for example `\"sqlite\" `.",
              "type": "string"
            },
            "status": {
              "const": "not_measured",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "Measured2": {
      "description": "The value a channel produced, or why it produced none.\n\nEvery channel of an [`crate::model::EffectRecord`] is wrapped in this, so\n\"nothing happened\" stays distinguishable from \"nothing was watched\".",
      "oneOf": [
        {
          "description": "The channel was observed and holds `value`.",
          "properties": {
            "status": {
              "const": "measured",
              "type": "string"
            },
            "value": {
              "description": "What the channel observed.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "status",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "The channel could not be observed; `reason` says why.",
          "properties": {
            "reason": {
              "description": "Why the channel is missing, for example `\"sqlite\" `.",
              "type": "string"
            },
            "status": {
              "const": "not_measured",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "NetEntry": {
      "additionalProperties": false,
      "description": "One HTTP request the page made.",
      "properties": {
        "failed": {
          "description": "Why the request failed, when it was aborted or blocked.",
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "description": "The method.",
          "type": "string"
        },
        "path": {
          "description": "The path, with query parameters.",
          "type": "string"
        },
        "req_body": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The request body, as a blob."
        },
        "res_body": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The response body, as a blob."
        },
        "status": {
          "description": "The status code, absent when the request never completed.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "method",
        "path"
      ],
      "type": "object"
    },
    "RowCounts": {
      "additionalProperties": false,
      "description": "Row counts per table for one kind of write.",
      "properties": {
        "counts": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Table name to row count, sorted by table.",
          "type": "object"
        },
        "rows": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The changed rows themselves, as a blob."
        }
      },
      "required": [
        "counts"
      ],
      "type": "object"
    },
    "SignalObservation": {
      "additionalProperties": false,
      "description": "One success or error signal the page showed.",
      "properties": {
        "kind": {
          "description": "`success` or `error`.",
          "type": "string"
        },
        "source": {
          "description": "What produced it: `role=alert`, `aria-live=assertive`, `toast:sonner`, `config`.",
          "type": "string"
        },
        "text": {
          "description": "The signal's visible text, normalized.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "text"
      ],
      "type": "object"
    },
    "Storage": {
      "additionalProperties": false,
      "description": "Browser storage after the action.",
      "properties": {
        "cookies": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Cookie names and values, sorted by name.",
          "type": "object"
        },
        "indexeddb": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "IndexedDB entries, sorted by key.",
          "type": "object"
        },
        "local": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "`localStorage` entries, sorted by key.",
          "type": "object"
        },
        "session": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "`sessionStorage` entries, sorted by key.",
          "type": "object"
        }
      },
      "required": [
        "local",
        "session",
        "indexeddb",
        "cookies"
      ],
      "type": "object"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "Ui": {
      "additionalProperties": false,
      "description": "The browser's view of what the action changed.",
      "properties": {
        "dialog": {
          "description": "A dialog the action opened, as text.",
          "type": [
            "string",
            "null"
          ]
        },
        "dom_changed": {
          "description": "Whether the normalized DOM changed at all.",
          "type": "boolean"
        },
        "dom_hash_after": {
          "description": "Content-derived hash of the normalized DOM after the action.",
          "type": "string"
        },
        "dom_hash_before": {
          "description": "Content-derived hash of the normalized DOM before the action.",
          "type": "string"
        },
        "download": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "A download the action started, as a blob."
        },
        "url_after": {
          "description": "The URL after the action settled.",
          "type": "string"
        },
        "url_before": {
          "description": "The URL before the action.",
          "type": "string"
        }
      },
      "required": [
        "url_before",
        "url_after",
        "dom_changed",
        "dom_hash_before",
        "dom_hash_after"
      ],
      "type": "object"
    },
    "WsFrame": {
      "additionalProperties": false,
      "description": "One WebSocket frame.",
      "properties": {
        "bytes": {
          "description": "The payload size in bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "direction": {
          "description": "`sent` or `received`.",
          "type": "string"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The frame payload, as a blob when large."
        },
        "url": {
          "description": "The socket URL.",
          "type": "string"
        }
      },
      "required": [
        "url",
        "direction",
        "bytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One event the driver writes.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "The driver is ready for a command.",
      "properties": {
        "event": {
          "const": "ready",
          "type": "string"
        }
      },
      "required": [
        "event"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The browser channels of one action.\n\nBoxed, because a record part is much larger than the other events.",
      "properties": {
        "axe_violations": {
          "description": "Axe-core violations, when `axe` ran.",
          "items": {
            "$ref": "#/$defs/AxeViolation"
          },
          "type": "array"
        },
        "db": {
          "anyOf": [
            {
              "$ref": "#/$defs/DbDelta"
            },
            {
              "type": "null"
            }
          ],
          "description": "Channels the recorder captures itself, absent here."
        },
        "egress": {
          "description": "Channels the recorder captures itself, absent here.",
          "items": {
            "$ref": "#/$defs/EgressEntry"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "email": {
          "description": "Channels the recorder captures itself, absent here.",
          "items": {
            "$ref": "#/$defs/EmailEntry"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "event": {
          "const": "record_part",
          "type": "string"
        },
        "logs": {
          "$ref": "#/$defs/Logs",
          "description": "Console and page errors; the server part is filled in by the recorder."
        },
        "net": {
          "description": "Requests in order.",
          "items": {
            "$ref": "#/$defs/NetEntry"
          },
          "type": "array"
        },
        "queries": {
          "description": "Channels the recorder captures itself, absent here.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "settled_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "When the action settled, on the frozen clock."
        },
        "signals": {
          "description": "Success and error signals the page showed, in discovery order.",
          "items": {
            "$ref": "#/$defs/SignalObservation"
          },
          "type": "array"
        },
        "storage": {
          "$ref": "#/$defs/Storage",
          "description": "Browser storage after the action."
        },
        "ui": {
          "$ref": "#/$defs/Ui",
          "description": "The browser's view of the change."
        },
        "visible_text": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Visible text by element, for unused-field detection.",
          "type": "object"
        },
        "ws": {
          "$ref": "#/$defs/Measured",
          "description": "WebSocket frames, or a reason they were not captured."
        }
      },
      "required": [
        "event",
        "ui",
        "net",
        "ws",
        "storage",
        "logs",
        "settled_at",
        "visible_text",
        "axe_violations",
        "signals"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The driver reports a problem with the command.",
      "properties": {
        "cmd": {
          "description": "The command that failed.",
          "type": "string"
        },
        "event": {
          "const": "error",
          "type": "string"
        },
        "message": {
          "description": "The message, with session secrets replaced.",
          "type": "string"
        },
        "recoverable": {
          "description": "Whether the driver kept the context usable.",
          "type": "boolean"
        }
      },
      "required": [
        "event",
        "cmd",
        "message",
        "recoverable"
      ],
      "type": "object"
    },
    {
      "description": "What a command found, for the commands that return a result rather than a record part.\n\nA command that reports through `record_part` (an `act`, a `goto`) leaves this out. The\ntwo are separate events because a result is not an effect: `list_controls` describes what\nthe page offers, and folding that into a record part would put a description of the page\ninto a record of what an action changed.",
      "oneOf": [
        {
          "description": "The interactive controls `list_controls` found, on the page it was asked about.",
          "properties": {
            "controls": {
              "description": "The controls, in document order.",
              "items": {
                "$ref": "#/$defs/Control"
              },
              "type": "array"
            },
            "kind": {
              "const": "controls",
              "type": "string"
            },
            "screen": {
              "description": "The path the walk ran on, without query or fragment.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "screen",
            "controls"
          ],
          "type": "object"
        },
        {
          "description": "The boxes `layout` measured.",
          "properties": {
            "boxes": {
              "description": "One box per element that was measured.",
              "items": {
                "$ref": "#/$defs/LayoutBox"
              },
              "type": "array"
            },
            "kind": {
              "const": "layout",
              "type": "string"
            },
            "screen": {
              "description": "The path the measurement ran on, without query or fragment.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "screen",
            "boxes"
          ],
          "type": "object"
        },
        {
          "description": "The normalized DOM hash and the visible-text map `snapshot_dom` produced.",
          "properties": {
            "dom_hash": {
              "description": "The content hash of the normalized DOM.",
              "type": "string"
            },
            "kind": {
              "const": "snapshot_dom",
              "type": "string"
            },
            "screen": {
              "description": "The path the snapshot was taken on, without query or fragment.",
              "type": "string"
            },
            "visible_text": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Visible text by element, for unused-field detection.",
              "type": "object"
            }
          },
          "required": [
            "kind",
            "screen",
            "dom_hash",
            "visible_text"
          ],
          "type": "object"
        },
        {
          "description": "The axe-core violations `axe` found.",
          "properties": {
            "kind": {
              "const": "axe",
              "type": "string"
            },
            "screen": {
              "description": "The path axe ran on, without query or fragment.",
              "type": "string"
            },
            "violations": {
              "description": "One entry per violated rule, in the order axe reported them.",
              "items": {
                "$ref": "#/$defs/AxeViolation"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "screen",
            "violations"
          ],
          "type": "object"
        },
        {
          "description": "What a login changed, for the session the recorder will reuse.",
          "properties": {
            "changed": {
              "description": "The keys that appeared or changed, sorted: `localStorage:token`, `cookie:sid`.\n\nValues are not included. This is the answer to \"did logging in do anything\", and the\nanswer does not need the secret that was just used to obtain it.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "login",
              "type": "string"
