    "FindingId": {
      "description": "A finding identifier: `fnd_<26 base32 chars>`.\n\nHashed from (run_id, check ID, target, sub-check).",
      "type": "string"
    },
    "Target": {
      "description": "What a check or a record is about.\n\nSerialized in serde's external form: `\"repo\"` or `{\"file\": \"src/main.rs\"}`.",
      "oneOf": [
        {
          "const": "repo",
          "description": "The repository as a whole.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "One file, by repo-relative path.",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One route template, for example `\"/invoices/:id\"`.",
          "properties": {
            "route": {
              "type": "string"
            }
          },
          "required": [
            "route"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One screen reached by the crawl.",
          "properties": {
            "screen": {
              "type": "string"
            }
          },
          "required": [
            "screen"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One control, by role and accessible name.",
          "properties": {
            "control": {
              "type": "string"
            }
          },
          "required": [
            "control"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One API endpoint, by method and path template.",
          "properties": {
            "endpoint": {
              "type": "string"
            }
          },
          "required": [
            "endpoint"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One database table.",
          "properties": {
            "table": {
              "type": "string"
            }
          },
          "required": [
            "table"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One dependency.",
          "properties": {
            "dependency": {
              "type": "string"
            }
          },
          "required": [
            "dependency"
          ],
          "type": "object"
        }
      ]
    },
    "Verdict": {
      "description": "What one check decided about one target.",
      "oneOf": [
        {
          "const": "pass",
          "description": "The check ran and found nothing.",
          "type": "string"
        },
        {
          "const": "fail",
          "description": "The check ran and reproduced the failure.",
          "type": "string"
        },
        {
          "const": "flaky",
          "description": "The failure appeared in some repetitions but not all; the 3-of-3 rule failed.",
          "type": "string"
        },
        {
          "const": "reported",
          "description": "The check ran and recorded metrics, but has no threshold yet (ADR-0013).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The check could not run or lacked an input; always carries a reason.",
          "properties": {
            "not_measured": {
              "properties": {
                "reason": {
                  "description": "Why the check did not run, for example `\"needs --allow-exec\"`.",
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "not_measured"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The check ran, but its evidence cannot decide.",
          "properties": {
            "unverifiable": {
              "properties": {
                "reason": {
                  "description": "Why the evidence cannot decide.",
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "unverifiable"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One check's result on one target.",
  "properties": {
    "check_id": {
      "$ref": "#/$defs/CheckId",
      "description": "The check."
    },
    "finding_ids": {
      "description": "Findings this verdict rests on, sorted by ID.",
      "items": {
        "$ref": "#/$defs/FindingId"
      },
      "type": "array"
    },
    "metrics": {
      "additionalProperties": {
        "format": "int64",
        "type": "integer"
      },
      "description": "Named measurements, sorted by key.\n\nJSON Schema renders these as integers; TypeScript gets `number`, because\n`ts-rs` would otherwise emit the TS big integer type, which `JSON.parse`\nnever produces.\nEvery metric value stays within ±2^53.",
      "type": "object"
    },
    "parts": {
      "additionalProperties": {
        "$ref": "#/$defs/Verdict"
      },
      "description": "Per-part verdicts for checks built in stages (O01, S11, L05); empty otherwise.",
      "type": "object"
    },
    "target": {
      "$ref": "#/$defs/Target",
      "description": "What the check judged."
    },
    "verdict": {
      "$ref": "#/$defs/Verdict",
      "description": "The verdict."
    }
  },
  "required": [
    "check_id",
    "target",
    "verdict",
    "finding_ids",
    "metrics",
    "parts"
  ],
  "title": "CheckVerdict",
  "type": "object"
}
