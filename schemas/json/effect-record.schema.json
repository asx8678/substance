{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "One action the driver performed, and what it proved the app was in.",
      "properties": {
        "input": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Free-form input, for example `{\"value\": \"42\"}`.",
          "type": "object"
        },
        "kind": {
          "description": "`click`, `fill`, `select`, `press`, `submit`, `goto`, `login` or `logout`.",
          "type": "string"
        },
        "screen": {
          "description": "The route the action ran on.",
          "type": "string"
        },
        "target": {
          "description": "The selector the action addressed, empty for a navigation.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target",
        "screen",
        "input"
      ],
      "type": "object"
    },
    "BlobRef": {
      "description": "A content-addressed blob reference, written as `sha256:<hex>`.",
      "type": "string"
    },
