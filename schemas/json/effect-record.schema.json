          ],
          "type": "object"
        },
        {
          "description": "The channel could not be observed; `reason` says why.",
          "properties": {
            "reason": {
              "description": "Why the channel is missing, for example `\"sqlite\" `.",
              "type": "string"
            },
            "status": {
              "const": "not_measured",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "NetEntry": {
      "additionalProperties": false,
      "description": "One HTTP request the page made.",
      "properties": {
        "failed": {
          "description": "Why the request failed, when it was aborted or blocked.",
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "description": "The method.",
          "type": "string"
        },
        "path": {
          "description": "The path, with query parameters.",
          "type": "string"
        },
        "req_body": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The request body, as a blob."
        },
        "req_normalized": {
          "description": "The lookup key of the request body's normalized form, next to the raw blob.\n\nThe raw bytes are what was sent; this is what they hash to once the volatile values are\nreplaced. Two runs whose responses differ only in a timestamp refer to different raw blobs but\nthe same normalized hash, which is what makes them comparable without re-reading the blob\n(M3-T05).",
          "type": [
            "string",
            "null"
          ]
        },
        "res_body": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The response body, as a blob."
        },
        "res_normalized": {
          "description": "The lookup key of the response body's normalized form, next to the raw blob.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "The status code, absent when the request never completed.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "method",
        "path"
      ],
      "type": "object"
    },
    "RecordId": {
      "description": "An effect-record identifier: `rec_<26 base32 chars>`.\n\nHashed from (run_id, check ID, target, step index, repetition).",
      "type": "string"
    },
    "RowCounts": {
      "additionalProperties": false,
      "description": "Row counts per table for one kind of write.",
      "properties": {
        "counts": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Table name to row count, sorted by table.",
          "type": "object"
        },
        "rows": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The changed rows themselves, as a blob."
        }
      },
      "required": [
        "counts"
      ],
      "type": "object"
    },
    "RunId": {
      "description": "A run identifier: `run_<26 base32 chars>`.\n\nHashed from the run manifest with the `run_id` field removed.",
      "type": "string"
    },
    "SnapshotId": {
      "description": "A snapshot identifier: `snap_<26 base32 chars>`.\n\nHashed from (run_id, snapshot name).",
      "type": "string"
    },
    "Storage": {
      "additionalProperties": false,
      "description": "Browser storage after the action.",
      "properties": {
        "cookies": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Cookie names and values, sorted by name.",
          "type": "object"
        },
        "indexeddb": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "IndexedDB entries, sorted by key.",
          "type": "object"
        },
        "local": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "`localStorage` entries, sorted by key.",
          "type": "object"
        },
        "session": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "`sessionStorage` entries, sorted by key.",
          "type": "object"
        }
      },
      "required": [
        "local",
        "session",
        "indexeddb",
        "cookies"
      ],
      "type": "object"
    },
    "Target": {
      "description": "What a check or a record is about.\n\nSerialized in serde's external form: `\"repo\"` or `{\"file\": \"src/main.rs\"}`.",
      "oneOf": [
        {
          "const": "repo",
          "description": "The repository as a whole.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "One file, by repo-relative path.",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One route template, for example `\"/invoices/:id\"`.",
          "properties": {
            "route": {
              "type": "string"
            }
          },
          "required": [
            "route"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One screen reached by the crawl.",
          "properties": {
            "screen": {
              "type": "string"
            }
          },
          "required": [
            "screen"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One control, by role and accessible name.",
          "properties": {
            "control": {
              "type": "string"
            }
          },
          "required": [
            "control"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One API endpoint, by method and path template.",
          "properties": {
            "endpoint": {
              "type": "string"
            }
          },
          "required": [
            "endpoint"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One database table.",
          "properties": {
            "table": {
              "type": "string"
            }
          },
          "required": [
            "table"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One dependency.",
          "properties": {
            "dependency": {
              "type": "string"
            }
          },
          "required": [
            "dependency"
          ],
          "type": "object"
        }
      ]
    },
    "Timing": {
      "additionalProperties": false,
      "description": "How long the action took to settle.",
      "properties": {
        "settle_ms": {
          "description": "Milliseconds until the settle rule was satisfied. Left out of the normalized form.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "timed_out": {
          "description": "Whether the settle cap fired instead of the settle rule.",
          "type": "boolean"
        }
      },
      "required": [
        "settle_ms",
        "timed_out"
      ],
      "type": "object"
    },
    "Ui": {
      "additionalProperties": false,
      "description": "The browser's view of what the action changed.",
      "properties": {
        "dialog": {
          "description": "A dialog the action opened, as text.",
          "type": [
            "string",
            "null"
          ]
        },
        "dom_changed": {
          "description": "Whether the normalized DOM changed at all.",
          "type": "boolean"
        },
        "dom_hash_after": {
          "description": "Content-derived hash of the normalized DOM after the action.",
          "type": "string"
        },
        "dom_hash_before": {
          "description": "Content-derived hash of the normalized DOM before the action.",
          "type": "string"
        },
        "download": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "A download the action started, as a blob."
        },
        "url_after": {
          "description": "The URL after the action settled.",
          "type": "string"
        },
        "url_before": {
          "description": "The URL before the action.",
          "type": "string"
        }
      },
      "required": [
        "url_before",
        "url_after",
        "dom_changed",
        "dom_hash_before",
        "dom_hash_after"
      ],
      "type": "object"
    },
    "WsFrame": {
      "additionalProperties": false,
      "description": "One WebSocket frame.",
      "properties": {
        "bytes": {
          "description": "The payload size in bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "direction": {
          "description": "`sent` or `received`.",
          "type": "string"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The frame payload, as a blob when large."
        },
        "url": {
          "description": "The socket URL.",
          "type": "string"
        }
      },
      "required": [
        "url",
        "direction",
        "bytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Everything one action changed, across every channel (ADR-0014).",
  "properties": {
    "action": {
      "$ref": "#/$defs/Action",
      "description": "The action under test."
    },
    "check_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/CheckId"
        },
        {
          "type": "null"
        }
      ],
      "description": "The check that asked for the action, or `None` for the crawl's own records.\n\nThe crawler (M4-T01) observes every control on every screen, and no check asked for those\nactions: they are what the app does, not a probe of a defect. Making the field optional rather\nthan inventing a pseudo-check keeps \"which check produced this?\" answerable with \"none\", which\nis true, instead of naming a check that never ran. Every other record has one, and the\nrecord id derives from it, so a crawl record can never collide with a check's record."
    },
    "db": {
      "$ref": "#/$defs/Measured2",
      "description": "Database writes."
    },
    "egress": {
      "$ref": "#/$defs/Measured4",
      "description": "Third-party requests in order."
    },
    "email": {
      "$ref": "#/$defs/Measured5",
      "description": "Emails sent, in order."
    },
    "id": {
      "$ref": "#/$defs/RecordId",
      "description": "Content-derived record ID."
    },
    "injected": {
      "$ref": "#/$defs/Injected",
      "description": "What was injected before the action ran."
    },
    "logs": {
      "$ref": "#/$defs/Logs",
      "description": "Console, page and server errors."
    },
    "net": {
      "description": "Requests in order.",
      "items": {
        "$ref": "#/$defs/NetEntry"
      },
      "type": "array"
    },
    "queries": {
      "$ref": "#/$defs/Measured3",
      "description": "Queries the action ran, when the engine can count them."
    },
    "repetition": {
      "description": "Which repetition of the action this is; the 3-of-3 rule uses 1 to 3.",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "run_id": {
      "$ref": "#/$defs/RunId",
      "description": "The run this record belongs to."
    },
    "seed": {
      "description": "The seed of the random-input generator for this action.",
      "type": "string"
    },
    "setup": {
      "description": "Steps run on a fresh snapshot before `action`, for example login and navigation.",
      "items": {
        "$ref": "#/$defs/Action"
      },
      "type": "array"
    },
    "snapshot": {
      "$ref": "#/$defs/SnapshotId",
      "description": "The snapshot the action ran on."
    },
    "storage": {
      "$ref": "#/$defs/Storage",
      "description": "Browser storage after the action."
    },
    "target": {
      "$ref": "#/$defs/Target",
      "description": "What the record is about."
    },
    "timing": {
      "$ref": "#/$defs/Timing",
      "description": "Timing for the action."
    },
    "ui": {
      "$ref": "#/$defs/Ui",
      "description": "The browser's view of the change."
    },
    "ws": {
      "$ref": "#/$defs/Measured",
      "description": "WebSocket frames in order."
    }
  },
  "required": [
    "id",
    "run_id",
    "target",
    "snapshot",
    "repetition",
    "seed",
    "setup",
    "action",
    "injected",
    "ui",
    "net",
    "ws",
    "storage",
    "db",
    "logs",
    "queries",
    "egress",
    "email",
    "timing"
  ],
  "title": "EffectRecord",
  "type": "object"
}
