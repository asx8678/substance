          "properties": {
            "forge_object": {
              "$ref": "#/$defs/ForgeObject"
            }
          },
          "required": [
            "forge_object"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An object in a package registry.",
          "properties": {
            "registry_object": {
              "$ref": "#/$defs/RegistryObject"
            }
          },
          "required": [
            "registry_object"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A tool's own output, as a blob.",
          "properties": {
            "tool_output": {
              "$ref": "#/$defs/ToolOutput"
            }
          },
          "required": [
            "tool_output"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A sentence of explanation that stands alone.",
          "properties": {
            "note": {
              "type": "string"
            }
          },
          "required": [
            "note"
          ],
          "type": "object"
        }
      ]
    },
    "FileRange": {
      "additionalProperties": false,
      "description": "A line range in a file.",
      "properties": {
        "end_line": {
          "description": "Last line, 1-based and inclusive.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Repo-relative path.",
          "type": "string"
        },
        "start_line": {
          "description": "First line, 1-based.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start_line",
        "end_line"
      ],
      "type": "object"
    },
    "FindingId": {
      "description": "A finding identifier: `fnd_<26 base32 chars>`.\n\nHashed from (run_id, check ID, target, sub-check).",
      "type": "string"
    },
    "ForgeObject": {
      "additionalProperties": false,
      "description": "An issue, pull request or release.",
      "properties": {
        "id": {
          "description": "The forge's identifier.",
          "type": "string"
        },
        "kind": {
          "description": "`issue`, `pull_request` or `release`.",
          "type": "string"
        },
        "url": {
          "description": "The URL.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "url"
      ],
      "type": "object"
    },
    "RecordId": {
      "description": "An effect-record identifier: `rec_<26 base32 chars>`.\n\nHashed from (run_id, check ID, target, step index, repetition).",
      "type": "string"
    },
    "RegistryObject": {
      "additionalProperties": false,
      "description": "A package-registry object.",
      "properties": {
        "package": {
          "description": "The package name.",
          "type": "string"
        },
        "registry": {
          "description": "`npm`, `pypi` or `crates`.",
          "type": "string"
        },
        "version": {
          "description": "The version or range.",
          "type": "string"
        }
      },
      "required": [
        "registry",
        "package",
        "version"
      ],
      "type": "object"
    },
    "Severity": {
      "description": "How bad a failure is. Fixed per check, uncalibrated (ADR-0010).",
      "oneOf": [
        {
          "const": "critical",
          "description": "Critical: a hard gate or a severe trust failure.",
          "type": "string"
        },
        {
          "const": "high",
          "description": "High.",
          "type": "string"
        },
        {
          "const": "medium",
          "description": "Medium.",
          "type": "string"
        },
        {
          "const": "low",
