    "SignalsConfig": {
      "additionalProperties": false,
      "description": "Extra selectors that stand in for agent labels (M12).",
      "properties": {
        "error": {
          "default": [],
          "description": "Selectors that claim an error, in matching order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "success": {
          "default": [],
          "description": "Selectors that claim success, in matching order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SignupConfig": {
      "additionalProperties": false,
      "description": "The account creation request.",
      "properties": {
        "api": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The request that creates an account."
        }
      },
      "type": "object"
    },
    "UserConfig": {
      "additionalProperties": false,
      "description": "One test account. Secrets are named, never stored.",
      "properties": {
        "create": {
          "$ref": "#/$defs/UserCreate",
          "default": "api",
          "description": "How the account is created."
        },
        "email": {
          "default": "",
          "description": "The address to register and to read mail at.",
          "type": "string"
        },
        "handle": {
          "default": "",
          "description": "The handle that identifies the account in reports.",
          "type": "string"
        },
        "password_env": {
          "default": "",
          "description": "The name of the environment variable that holds the password.",
          "type": "string"
        },
        "role": {
          "default": "",
          "description": "The role this account proves, for example `user` or `admin`.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "UserCreate": {
      "description": "How a `[[users]]` account is created (M2-T04).",
      "oneOf": [
        {
          "const": "api",
          "description": "Through the `[signup]` request template.",
          "type": "string"
        },
        {
          "const": "sql",
          "description": "With SQL against the run database.",
          "type": "string"
        },
        {
          "const": "supabase",
          "description": "Through the Supabase GoTrue admin API.",
          "type": "string"
        },
        {
          "const": "ui",
          "description": "Through the app's own signup form.",
          "type": "string"
        },
        {
          "const": "existing",
          "description": "It already exists after seeding.",
          "type": "string"
        }
      ]
    }
  },
