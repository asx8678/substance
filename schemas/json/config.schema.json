{
  "$defs": {
    "ApiRequest": {
      "additionalProperties": false,
      "description": "An HTTP request template the runner sends on the app's behalf.",
      "properties": {
        "body": {
          "default": null,
          "description": "The body template, with `{email}`, `{password}` and `{handle}` placeholders.",
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "default": "POST",
          "description": "The method.",
          "type": "string"
        },
        "path": {
          "default": "",
          "description": "The path, relative to the app's origin.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "AppConfig": {
      "additionalProperties": false,
      "description": "How the app is installed, built, migrated, seeded and started (boot ladder rung 2, ADR-0017).",
      "properties": {
        "build": {
          "default": null,
          "description": "The build command.",
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Extra environment for every command, sorted by name.",
          "type": "object"
        },
        "health_path": {
          "default": null,
          "description": "The path O06 probes with the database down; no path means O06 is not measured.",
          "type": [
            "string",
            "null"
          ]
        },
        "install": {
          "default": null,
          "description": "The install command, for example `npm ci`.",
          "type": [
            "string",
            "null"
          ]
        },
        "migrate": {
          "default": null,
          "description": "The migration command.",
          "type": [
            "string",
            "null"
          ]
        },
        "port_env": {
          "default": "PORT",
          "description": "The variable the server reads its port from.",
          "type": "string"
        },
        "ready_path": {
          "default": "/",
          "description": "The path that answers once the server is up.",
          "type": "string"
        },
        "seed": {
          "default": null,
          "description": "The seed command.",
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "default": null,
          "description": "The command that starts the long-running server; substance supplies the port.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Budgets": {
      "additionalProperties": false,
      "description": "Time and count limits, in seconds, milliseconds or counts (ADR-0002).",
      "properties": {
        "blame_max_files": {
          "default": 5000,
          "description": "Files the blame check may inspect.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "crawl_max_actions": {
          "default": 2000,
          "description": "Actions the crawl may run.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "crawl_max_depth": {
          "default": 6,
          "description": "Crawl depth.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "crawl_max_screens": {
          "default": 200,
          "description": "Screens the crawl may visit.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "forge_max_requests": {
          "default": 3000,
          "description": "Requests the forge check may send.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "idle_baseline_ms": {
          "default": 5000,
          "description": "How long the idle baseline is sampled.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "run_s": {
          "default": 1800,
          "description": "Whole-run time limit.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "settle_quiet_ms": {
          "default": 500,
          "description": "How long the network must stay quiet before an action counts as settled.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "settle_timeout_ms": {
          "default": 10000,
          "description": "The cap on settling one action.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "shutdown_grace_s": {
          "default": 30,
          "description": "How long a server gets to exit before it is killed.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "triage_s": {
          "default": 120,
          "description": "Triage time limit.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
