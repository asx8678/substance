    "ChecksConfig": {
      "additionalProperties": false,
      "description": "Checks the project switched off. They are reported as `not_measured` (M0-T08).",
      "properties": {
        "disable": {
          "default": [],
          "description": "The checks to skip, in ID order and without duplicates.",
          "items": {
            "$ref": "#/$defs/CheckId"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "DbConfig": {
      "additionalProperties": false,
      "description": "The database section of the config.",
      "properties": {
        "engine": {
          "$ref": "#/$defs/DbEngine",
          "default": "postgres",
          "description": "The engine."
        },
        "retained_tables": {
          "default": [],
          "description": "Tables B25 excludes from the deletion check, because the law keeps their rows.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "sqlite_path": {
          "default": null,
          "description": "The SQLite file, relative to the repository root.",
          "type": [
            "string",
            "null"
          ]
        },
        "url_env": {
          "default": "DATABASE_URL",
          "description": "The variable the app reads its connection URL from.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "DbEngine": {
      "description": "Which database the app uses (ADR-0018).",
      "oneOf": [
        {
          "const": "postgres",
          "description": "Postgres, with logical decoding for the database channel.",
          "type": "string"
        },
        {
          "const": "sqlite",
          "description": "A SQLite file.",
          "type": "string"
        },
        {
          "const": "supabase",
          "description": "A local Supabase stack.",
          "type": "string"
        }
      ]
    },
    "EgressConfig": {
      "additionalProperties": false,
      "description": "Hosts the egress proxy lets through (M3-T04).",
      "properties": {
        "allow": {
          "default": [],
          "description": "Allowed hosts. The proxy denies everything else.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "LoginConfig": {
      "additionalProperties": false,
      "description": "How to log in (M4-T01). Set `ui` or `api`; set neither to let the crawl detect a\nsingle password form, and set both to log in through the API and check the form.",
      "properties": {
        "api": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The request to send instead of filling the form."
        },
        "ui": {
          "anyOf": [
            {
              "$ref": "#/$defs/LoginUi"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The form to fill."
        }
      },
      "type": "object"
    },
    "LoginUi": {
      "additionalProperties": false,
      "description": "A login form the crawl can fill.",
      "properties": {
        "identifier": {
          "default": "",
          "description": "The selector of the identifier field.",
          "type": "string"
        },
        "password": {
          "default": "",
          "description": "The selector of the password field.",
          "type": "string"
        },
        "path": {
          "default": "",
          "description": "The path of the login screen.",
          "type": "string"
        },
        "submit": {
          "default": "",
          "description": "The selector of the submit control.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "MailConfig": {
      "additionalProperties": false,
      "description": "The app's mail environment. Mailpit supplies the values (M3-T04).\n\n`Default` is written out rather than derived, because the container's `serde(default)` takes\nmissing fields from it: a derived default would make `poll_ms` zero for any project that omits\nthe section, and a zero wait reports \"no mail\" before the app has had a chance to send one.",
      "properties": {
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "The environment the app gets, sorted by name, with `{smtp_host}` and `{smtp_port}`\nfilled in by the runner.",
          "type": "object"
        },
        "poll_ms": {
          "default": 10000,
          "description": "How long B27 waits for a message after triggering a flow, in milliseconds.\n\nThe plan says ten seconds. Configurable because a mailer in a slow run can take longer, and\na fixed wait would turn \"the mail was late\" into \"no mail was sent\". Omitted means the\ndefault, not zero: a zero wait would report every flow as \"no mail\" the instant it started.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "NormalizeConfig": {
      "additionalProperties": false,
      "description": "Project normalization rules, applied before hashing and diffing.",
      "properties": {
        "patterns": {
          "default": [],
          "description": "The rules, in the order they are applied. The built-in rules come first.",
          "items": {
            "$ref": "#/$defs/NormalizePattern"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "NormalizePattern": {
      "additionalProperties": false,
      "description": "One normalization rule.",
      "properties": {
        "regex": {
          "description": "The pattern to replace.",
          "type": "string"
        },
        "replace": {
          "description": "What to replace it with.",
          "type": "string"
        }
      },
      "required": [
        "regex",
        "replace"
      ],
      "type": "object"
