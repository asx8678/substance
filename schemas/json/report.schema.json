    "CheckVerdict": {
      "additionalProperties": false,
      "description": "One check's result on one target.",
      "properties": {
        "check_id": {
          "$ref": "#/$defs/CheckId",
          "description": "The check."
        },
        "finding_ids": {
          "description": "Findings this verdict rests on, sorted by ID.",
          "items": {
            "$ref": "#/$defs/FindingId"
          },
          "type": "array"
        },
        "metrics": {
          "additionalProperties": {
            "format": "int64",
            "type": "integer"
          },
          "description": "Named measurements, sorted by key.\n\nJSON Schema renders these as integers; TypeScript gets `number`, because\n`ts-rs` would otherwise emit the TS big integer type, which `JSON.parse`\nnever produces.\nEvery metric value stays within ±2^53.",
          "type": "object"
        },
        "parts": {
          "additionalProperties": {
            "$ref": "#/$defs/Verdict"
          },
          "description": "Per-part verdicts for checks built in stages (O01, S11, L05); empty otherwise.",
          "type": "object"
        },
        "target": {
          "$ref": "#/$defs/Target",
          "description": "What the check judged."
        },
        "verdict": {
          "$ref": "#/$defs/Verdict",
          "description": "The verdict."
        }
      },
      "required": [
        "check_id",
        "target",
        "verdict",
        "finding_ids",
        "metrics",
        "parts"
      ],
      "type": "object"
    },
    "Confidence": {
      "description": "How much a finding can be trusted.",
      "oneOf": [
        {
          "const": "confirmed",
          "description": "Confirmed by behavior.",
          "type": "string"
        },
        {
          "const": "flaky",
          "description": "Seen inconsistently, set by the 3-of-3 rule at runtime.",
          "type": "string"
        },
        {
          "const": "hint",
          "description": "A static hint that explains rather than decides.",
          "type": "string"
        }
      ]
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "How much of the app the run actually reached.",
      "properties": {
        "checks_measured": {
          "description": "Checks whose verdict counts as measured (ADR-0013).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "checks_total": {
          "description": "Registered checks.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "controls": {
          "description": "Controls exercised, in permille, when the crawl ran.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "routes": {
          "description": "Routes reached, in permille, when the crawl ran.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "server_code": {
          "description": "Authored server lines executed, in permille, when coverage ran.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "checks_total",
        "checks_measured"
      ],
      "type": "object"
    },
    "Evidence": {
      "description": "One reproducible artifact (principle 6).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "An effect record.",
          "properties": {
            "record": {
              "$ref": "#/$defs/RecordId"
            }
          },
          "required": [
            "record"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A content-addressed blob: a trace, a DOM dump, a screenshot.",
          "properties": {
            "blob": {
              "$ref": "#/$defs/BlobRef"
            }
          },
          "required": [
            "blob"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A commit SHA.",
          "properties": {
            "commit": {
              "type": "string"
            }
          },
          "required": [
            "commit"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A line range in a file.",
          "properties": {
            "file_range": {
              "$ref": "#/$defs/FileRange"
            }
          },
          "required": [
            "file_range"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An object on the forge: an issue, a pull request or a release.",
          "properties": {
            "forge_object": {
              "$ref": "#/$defs/ForgeObject"
            }
          },
          "required": [
            "forge_object"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An object in a package registry.",
          "properties": {
            "registry_object": {
              "$ref": "#/$defs/RegistryObject"
            }
          },
          "required": [
            "registry_object"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A tool's own output, as a blob.",
          "properties": {
            "tool_output": {
              "$ref": "#/$defs/ToolOutput"
            }
          },
          "required": [
            "tool_output"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A sentence of explanation that stands alone.",
          "properties": {
            "note": {
              "type": "string"
            }
          },
          "required": [
            "note"
          ],
          "type": "object"
        }
      ]
    },
    "FileRange": {
      "additionalProperties": false,
      "description": "A line range in a file.",
      "properties": {
        "end_line": {
          "description": "Last line, 1-based and inclusive.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Repo-relative path.",
          "type": "string"
        },
        "start_line": {
          "description": "First line, 1-based.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start_line",
        "end_line"
      ],
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "One reproducible reason the app failed a check.",
      "properties": {
        "cause": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cause"
            },
            {
              "type": "null"
            }
          ],
          "description": "The static explanation, when one exists."
        },
        "check_id": {
          "$ref": "#/$defs/CheckId",
          "description": "The check that produced the finding."
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "description": "How much the finding can be trusted."
        },
        "evidence": {
          "description": "Reproducible artifacts behind it, sorted by kind and reference.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/FindingId",
          "description": "Content-derived finding ID."
        },
        "related": {
          "description": "Findings that describe the same defect, sorted by ID.",
          "items": {
            "$ref": "#/$defs/FindingId"
          },
          "type": "array"
        },
        "replay": {
          "description": "The CLI command that replays it, for example `substance replay fnd_…`.",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "description": "How bad the finding is."
        },
        "sub_check": {
          "description": "The sub-check, when the check has named parts.",
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "$ref": "#/$defs/Target",
          "description": "What the finding is about."
        },
        "title": {
          "description": "One-line summary.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "check_id",
        "severity",
        "confidence",
        "title",
        "target",
        "evidence",
        "replay",
        "related"
      ],
      "type": "object"
    },
    "FindingId": {
      "description": "A finding identifier: `fnd_<26 base32 chars>`.\n\nHashed from (run_id, check ID, target, sub-check).",
      "type": "string"
    },
    "ForgeObject": {
      "additionalProperties": false,
      "description": "An issue, pull request or release.",
      "properties": {
        "id": {
          "description": "The forge's identifier.",
          "type": "string"
        },
        "kind": {
          "description": "`issue`, `pull_request` or `release`.",
          "type": "string"
        },
        "url": {
          "description": "The URL.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "url"
      ],
      "type": "object"
    },
    "Host": {
      "additionalProperties": false,
      "description": "The host the run happened on, for explanation only.",
      "properties": {
        "arch": {
          "description": "`aarch64` or `x86_64`.",
          "type": "string"
        },
        "os": {
          "description": "`macos`, `linux` or `windows`.",
          "type": "string"
        }
      },
      "required": [
        "os",
        "arch"
      ],
      "type": "object"
    },
    "KnowledgeCutoff": {
      "additionalProperties": false,
      "description": "The knowledge-cutoff estimate: the window V03's two inputs leave open.\n\nBoth bounds are lower bounds and both are deliberately loose: a dependency adopted in\n2022 could not have been known before it was published, and a call to an API retired in\n2023 was written before it was retired. The window is what those constraints leave, not a\nclaim about a model.",
      "properties": {
        "evidence": {
          "description": "The sentences the bracket rests on, sorted: which adoption set `from` and which\nvintage set `to`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "from": {
          "$ref": "#/$defs/Timestamp",
          "description": "The earliest instant the evidence permits, from adopted dependency releases."
        },
        "to": {
          "$ref": "#/$defs/Timestamp",
          "description": "The latest instant the evidence permits, from API vintages still in use."
        }
      },
      "required": [
        "from",
        "to",
        "evidence"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "The provenance panel: a profile, never a score.\n\nEvery field here is **reported**, never scored (ADR-0012): no field feeds a gate, a grade\nor the slop label. The panel answers \"how was this built\", and a reader weighs it; the\nchecks that judge the app never read it.\n\nThe plan's \"What the panel shows\" list is the shape: the declared share per tool and per\nmodel, then what could be said about review and tests, then the knowledge-cutoff bracket.\nA field whose input the run did not have stays absent or zero with\n`knowledge_cutoff_missing` or `notes` saying why — an absent share means nobody looked,\nand a share of zero would say nobody declared.",
      "properties": {
        "declared_commits": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Declared commits in total, per tool, sorted by tool.",
          "type": "object"
        },
        "declared_merged_unreviewed": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Declared commits merged with no review, per tool, sorted by tool.",
          "type": "object"
        },
        "declared_model_permille": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Share of today's lines by declared model, where a tool named one, in permille.\n\nA tool that names no model (Codex writes a static trailer) contributes to the tool\nshare and not to this one, so the difference between the two maps is visible.",
          "type": "object"
        },
        "declared_tool_permille": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Share of today's lines by declared tool, in permille. Sorted by tool name.",
          "type": "object"
        },
        "declared_without_test_change": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Declared commits that changed no test file, per tool, sorted by tool.",
          "type": "object"
        },
        "instruction_files": {
          "description": "The instruction files present at HEAD, sorted by path. Each names a tool, not a model.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "knowledge_cutoff": {
          "anyOf": [
            {
              "$ref": "#/$defs/KnowledgeCutoff"
            },
            {
              "type": "null"
            }
          ],
          "description": "The knowledge-cutoff bracket, when one could be made."
        },
        "knowledge_cutoff_missing": {
          "description": "Why the knowledge cutoff is absent, when it is. A missing input, said out loud.",
          "type": [
            "string",
            "null"
          ]
        },
        "lines_blamed": {
          "description": "How many of today's lines the blame covers, the denominator of every share.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "notes": {
          "description": "Every note the panel needs read beside it, sorted.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "undeclared_permille": {
          "description": "Share of today's lines with no declared tool, in permille.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "declared_tool_permille",
        "declared_model_permille",
        "undeclared_permille",
        "lines_blamed",
        "instruction_files",
        "declared_merged_unreviewed",
        "declared_without_test_change",
        "declared_commits",
        "notes"
      ],
      "type": "object"
    },
    "RecordId": {
      "description": "An effect-record identifier: `rec_<26 base32 chars>`.\n\nHashed from (run_id, check ID, target, step index, repetition).",
      "type": "string"
    },
    "RegistryObject": {
      "additionalProperties": false,
      "description": "A package-registry object.",
      "properties": {
        "package": {
          "description": "The package name.",
          "type": "string"
        },
        "registry": {
          "description": "`npm`, `pypi` or `crates`.",
          "type": "string"
        },
        "version": {
          "description": "The version or range.",
          "type": "string"
        }
      },
      "required": [
        "registry",
        "package",
        "version"
      ],
      "type": "object"
    },
    "RepoRef": {
      "additionalProperties": false,
      "description": "Where the code under test came from.",
      "properties": {
        "commit_sha": {
          "description": "The commit that was exported to the working copy.",
          "type": "string"
        },
        "origin": {
          "description": "The origin URL, without credentials.",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "commit_sha"
      ],
      "type": "object"
    },
    "RunId": {
      "description": "A run identifier: `run_<26 base32 chars>`.\n\nHashed from the run manifest with the `run_id` field removed.",
      "type": "string"
    },
    "RunManifest": {
      "additionalProperties": false,
      "description": "Every pinned input, and nothing that depends on where the run was invoked.",
      "properties": {
        "access_mode": {
          "$ref": "#/$defs/AccessMode",
          "description": "How the code was reached."
        },
        "allow_exec": {
          "description": "Whether `--allow-exec` was given.",
          "type": "boolean"
        },
        "as_of": {
          "$ref": "#/$defs/Timestamp",
          "description": "The instant every relative date is computed from."
        },
        "config_hash": {
          "description": "The project config's content hash.",
          "type": "string"
        },
        "egress_enforced": {
          "description": "Whether egress was actually enforced; false on the host runner (ADR-0003).",
          "type": "boolean"
        },
        "frozen_clock": {
          "$ref": "#/$defs/Timestamp",
          "description": "The clock value pinned for the browser and, when supported, the server."
        },
        "host": {
          "$ref": "#/$defs/Host",
          "description": "The host."
        },
        "locale": {
          "description": "The locale forced on the browser, normally `\"en-US\"`.",
          "type": "string"
        },
        "master_seed": {
          "description": "The master seed all generator seeds derive from.",
          "type": "string"
        },
        "models": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Model IDs, empty while the agent layer is off (ADR-0006).",
          "type": "object"
        },
        "repetitions": {
          "description": "How many times each action runs; 3, for the 3-of-3 rule.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "repo": {
          "$ref": "#/$defs/RepoRef",
          "description": "The code under test."
        },
        "rule_pack_hash": {
          "description": "The rule pack's content hash.",
          "type": "string"
        },
        "run_id": {
          "$ref": "#/$defs/RunId",
          "description": "Content-derived run ID."
        },
        "schema_version": {
          "description": "The report schema version this run writes.",
          "type": "string"
        },
        "scoring_weights_version": {
          "description": "The scoring weights version.",
          "type": "string"
        },
        "seeds": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "One seed per random-input generator, sorted by generator name.",
          "type": "object"
        },
        "server_clock": {
          "$ref": "#/$defs/ServerClock",
          "description": "Whether the server clock was moved or left real."
        },
        "substance_version": {
          "description": "The substance version.",
          "type": "string"
        },
        "thresholds_version": {
          "description": "The thresholds version.",
          "type": "string"
        },
        "timezone": {
          "description": "The timezone forced on the app, normally `\"UTC\"`.",
          "type": "string"
        },
        "tools": {
          "additionalProperties": {
            "$ref": "#/$defs/ToolVersion"
          },
          "description": "Tool versions found on `PATH`, sorted by tool name.",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "substance_version",
        "run_id",
        "repo",
        "access_mode",
        "as_of",
        "master_seed",
        "seeds",
        "frozen_clock",
        "server_clock",
        "timezone",
        "locale",
        "tools",
        "models",
        "rule_pack_hash",
        "thresholds_version",
        "scoring_weights_version",
        "config_hash",
        "allow_exec",
        "egress_enforced",
        "repetitions",
        "host"
      ],
      "type": "object"
    },
    "ServerClock": {
      "description": "How the server's clock behaves during the run.",
      "oneOf": [
        {
          "const": "fixed_start",
          "description": "Started at `frozen_clock` and left advancing (Linux only, ADR-0022).",
          "type": "string"
        },
        {
          "const": "real",
          "description": "The host's real clock; clock-dependent checks report not_measured.",
          "type": "string"
        }
      ]
    },
    "Severity": {
      "description": "How bad a failure is. Fixed per check, uncalibrated (ADR-0010).",
      "oneOf": [
        {
          "const": "critical",
          "description": "Critical: a hard gate or a severe trust failure.",
          "type": "string"
        },
        {
          "const": "high",
          "description": "High.",
          "type": "string"
        },
        {
          "const": "medium",
          "description": "Medium.",
          "type": "string"
        },
        {
          "const": "low",
          "description": "Low.",
          "type": "string"
        },
        {
          "const": "info",
          "description": "Informational.",
          "type": "string"
        }
      ]
    },
    "Target": {
      "description": "What a check or a record is about.\n\nSerialized in serde's external form: `\"repo\"` or `{\"file\": \"src/main.rs\"}`.",
      "oneOf": [
        {
          "const": "repo",
          "description": "The repository as a whole.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "One file, by repo-relative path.",
          "properties": {
            "file": {
              "type": "string"
            }
          },
          "required": [
            "file"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One route template, for example `\"/invoices/:id\"`.",
          "properties": {
            "route": {
              "type": "string"
            }
          },
          "required": [
            "route"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One screen reached by the crawl.",
          "properties": {
            "screen": {
              "type": "string"
            }
          },
          "required": [
            "screen"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One control, by role and accessible name.",
          "properties": {
            "control": {
              "type": "string"
            }
          },
          "required": [
            "control"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One API endpoint, by method and path template.",
          "properties": {
            "endpoint": {
              "type": "string"
            }
          },
          "required": [
            "endpoint"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One database table.",
          "properties": {
            "table": {
              "type": "string"
            }
          },
          "required": [
            "table"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One dependency.",
          "properties": {
            "dependency": {
              "type": "string"
            }
          },
          "required": [
            "dependency"
          ],
          "type": "object"
        }
      ]
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "ToolOutput": {
      "additionalProperties": false,
      "description": "A tool's output, kept as a blob plus the command that produced it.",
      "properties": {
        "blob": {
          "$ref": "#/$defs/BlobRef",
          "description": "The captured output."
        },
        "command": {
          "description": "The exact command line.",
          "type": "string"
        },
        "tool": {
          "description": "The tool, as named in `tools.toml`.",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "command",
        "blob"
      ],
      "type": "object"
    },
    "ToolVersion": {
      "additionalProperties": false,
      "description": "The version of a tool found on `PATH`.",
      "properties": {
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The blob holding the output."
        },
        "tool": {
          "description": "The tool, as named in `tools.toml`.",
          "type": "string"
        },
        "version": {
          "description": "The version it reported.",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version"
      ],
      "type": "object"
    },
    "Verdict": {
      "description": "What one check decided about one target.",
      "oneOf": [
        {
          "const": "pass",
          "description": "The check ran and found nothing.",
          "type": "string"
        },
        {
          "const": "fail",
          "description": "The check ran and reproduced the failure.",
          "type": "string"
        },
        {
          "const": "flaky",
          "description": "The failure appeared in some repetitions but not all; the 3-of-3 rule failed.",
          "type": "string"
        },
        {
          "const": "reported",
          "description": "The check ran and recorded metrics, but has no threshold yet (ADR-0013).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The check could not run or lacked an input; always carries a reason.",
          "properties": {
            "not_measured": {
              "properties": {
                "reason": {
                  "description": "Why the check did not run, for example `\"needs --allow-exec\"`.",
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "not_measured"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The check ran, but its evidence cannot decide.",
          "properties": {
            "unverifiable": {
              "properties": {
                "reason": {
                  "description": "Why the evidence cannot decide.",
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "unverifiable"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The report of one run.",
  "properties": {
    "archetype": {
      "anyOf": [
        {
          "$ref": "#/$defs/Archetype"
        },
        {
          "type": "null"
        }
      ],
      "description": "The history archetype, when history ran."
    },
    "coverage": {
      "$ref": "#/$defs/Coverage",
      "description": "How much was reached."
    },
    "findings": {
      "description": "Findings, sorted by ID.",
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "type": "array"
    },
    "manifest": {
      "$ref": "#/$defs/RunManifest",
      "description": "Every input the run pinned."
    },
    "notes": {
      "description": "Human-readable notes, for example a fired time cap.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "description": "The provenance panel, when provenance ran."
    },
    "schema_version": {
      "description": "The report schema version, for readers that must refuse a newer shape.",
      "type": "string"
    },
    "verdicts": {
      "description": "One verdict per check and target, sorted by (check ID, target).",
      "items": {
        "$ref": "#/$defs/CheckVerdict"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "manifest",
    "verdicts",
    "findings",
    "coverage",
    "notes"
  ],
  "title": "Report",
  "type": "object"
}
