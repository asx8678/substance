{
  "$defs": {
    "AccessMode": {
      "description": "How the run reaches the code under test. Only `repo` is accepted in v1 (ADR-0004).",
      "oneOf": [
        {
          "const": "repo",
          "description": "A repository, at a commit.",
          "type": "string"
        },
        {
          "const": "url",
          "description": "A live URL; kept in the schema, rejected by intake in v1.",
          "type": "string"
        },
        {
          "const": "repo_url",
          "description": "A repository plus a live URL; kept in the schema, rejected by intake in v1.",
          "type": "string"
        }
      ]
    },
    "Archetype": {
      "description": "The archetype the history checks assigned.",
      "oneOf": [
        {
          "const": "one_shot_dump",
          "description": "Most of today's code is from day one.",
          "type": "string"
        },
        {
          "const": "burst_then_abandoned",
          "description": "Activity in the first weeks, then nothing for 90 days.",
          "type": "string"
        },
        {
          "const": "young_and_iterating",
          "description": "Young, many active days, mostly edits.",
          "type": "string"
        },
        {
          "const": "solo_maintained",
          "description": "Recently active, bus factor one, answers issues.",
          "type": "string"
        },
        {
          "const": "team_maintained",
          "description": "Two or more people merging, most pull requests reviewed.",
          "type": "string"
        },
        {
          "const": "unverifiable_history",
          "description": "Commit dates predate the repository, so the timeline can't be trusted.",
          "type": "string"
        }
      ]
    },
    "BlobRef": {
      "description": "A content-addressed blob reference, written as `sha256:<hex>`.",
      "type": "string"
    },
    "Cause": {
      "additionalProperties": false,
      "description": "A static explanation a finding points at.",
      "properties": {
        "check_id": {
          "$ref": "#/$defs/CheckId",
          "description": "The hint's check, for example an S check."
        },
        "finding_id": {
          "$ref": "#/$defs/FindingId",
          "description": "The hint's finding."
        }
      },
      "required": [
        "check_id",
        "finding_id"
      ],
      "type": "object"
    },
